# Copy this file to .env.local for local development.
# Both values are PUBLIC - they are compiled into the browser bundle. Never put
# a private key or an RPC secret in this folder.

# The deployed TemiToken contract address (0x...)
NEXT_PUBLIC_TOKEN_ADDRESS=

# Free project id from cloud.reown.com (Create project -> AppKit -> Web)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
