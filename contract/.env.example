# Copy this file to .env and fill in the values.
# .env is git-ignored. NEVER commit it, screenshot it, or paste it into a chat.

# HTTPS RPC URL for Sepolia (free from alchemy.com -> create app -> Sepolia)
SEPOLIA_RPC_URL=

# Private key of your FRESH, EMPTY deployer wallet, starting with 0x.
# This wallet must hold no real funds. Only test ETH.
PRIVATE_KEY=

# API key from etherscan.io -> API Keys (free). Used for contract verification.
ETHERSCAN_API_KEY=
