# Copy this file to .env.local for local development.
# All three values are PUBLIC - Vite inlines anything prefixed VITE_ into the
# browser bundle. Never put a private key or an RPC secret in this folder.

# TemiToken contract address (0x...)
VITE_TOKEN_ADDRESS=0xc80AAD29a6De0bb8b7A8caa3f1103C8ecF6A71E0

# ClassSpinnerStaking contract address (0x...). Leave blank to run the app in
# Task 1 mode only (no wallet/staking layer).
VITE_STAKING_ADDRESS=

# Free project id from cloud.reown.com (Create project -> AppKit -> Web)
VITE_WALLETCONNECT_PROJECT_ID=
